[Unit]
Description=Tenuro database migrations for the %i slot's release
Documentation=https://github.com/jeffgicharu/tenuro/blob/main/deploy/README.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=tenuro-jobs
Group=tenuro-jobs
EnvironmentFile=/srv/tenuro/shared/ops.env
Environment=NODE_ENV=production
WorkingDirectory=/srv/tenuro/slots/%i
ExecStart=/srv/tenuro/slots/%i/runtime/bin/node --max-old-space-size=112 server/migrate.mjs
TimeoutStartSec=300
StateDirectory=tenuro-jobs
StateDirectoryMode=0700
UMask=0077

MemoryMax=160M
MemorySwapMax=0
TasksMax=32

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# AF_NETLINK lets os.networkInterfaces() work; IPAddressDeny still blocks all non-local traffic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
# V8's JIT needs writable and executable memory; every other protection stays on.
MemoryDenyWriteExecute=no
