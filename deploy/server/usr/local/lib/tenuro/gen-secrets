#!/bin/bash
# Creates /srv/tenuro/shared/app.env and ops.env with fresh database passwords and app secrets.
# Run once as root. Prints variable names only, never values. Refuses to overwrite.
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly APP=/srv/tenuro/shared/app.env
readonly OPS=/srv/tenuro/shared/ops.env
readonly PSQL=/usr/lib/postgresql/16/bin/psql

[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
for f in "$APP" "$OPS"; do
  if [ -e "$f" ]; then echo "$f already exists; refusing to overwrite" >&2; exit 1; fi
done

gen() { openssl rand -hex 32; }
OWNER_PW=$(gen)
APP_PW=$(gen)

# Passwords reach psql on stdin, never on a command line. The SET keeps them out of the
# server log even if log_statement is ever turned on.
runuser -u postgres -- "$PSQL" -X -q -v ON_ERROR_STOP=1 -d postgres >/dev/null <<SQL
SET log_statement = 'none';
ALTER ROLE tenuro     PASSWORD '${OWNER_PW}';
ALTER ROLE tenuro_app PASSWORD '${APP_PW}';
SQL

write() { # $1 file, $2 group; contents on stdin
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  cat >"$tmp"
  chown "root:$2" "$tmp"
  chmod 640 "$tmp"
  mv -f -- "$tmp" "$1"
}

write "$APP" tenuro <<EOF
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tenuro
PGUSER=tenuro_app
PGPASSWORD=${APP_PW}
SESSION_SECRET=$(gen)
SANDBOX_SECRET=$(gen)
ICS_FEED_SECRET=$(gen)
EOF

write "$OPS" tenuro-ops <<EOF
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tenuro
PGUSER=tenuro
PGPASSWORD=${OWNER_PW}
EOF

unset OWNER_PW APP_PW
echo "wrote $APP (root:tenuro 0640): PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD SESSION_SECRET SANDBOX_SECRET ICS_FEED_SECRET"
echo "wrote $OPS (root:tenuro-ops 0640): PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD"
