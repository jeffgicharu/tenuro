[Unit]
Description=Tenuro journey checks against the %i slot
Documentation=https://github.com/jeffgicharu/tenuro/blob/main/deploy/README.md

[Service]
Type=oneshot
User=tenuro-jobs
Group=tenuro-jobs
# Port and slot name only; this unit gets no credentials.
EnvironmentFile=/srv/tenuro/shared/slot-%i.env
Environment=NODE_ENV=production
WorkingDirectory=/srv/tenuro/slots/%i
ExecStart=/srv/tenuro/slots/%i/runtime/bin/node --max-old-space-size=96 server/smoke.mjs --selfcheck
TimeoutStartSec=120
UMask=0077

MemoryMax=128M
MemorySwapMax=0
TasksMax=32

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
# V8's JIT needs writable and executable memory; every other protection stays on.
MemoryDenyWriteExecute=no
