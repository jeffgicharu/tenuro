#!/bin/bash
# Activates one Tenuro release on the idle slot with zero downtime.
# Usage: tenuro-activate <40-character lowercase commit sha>
#
# The call returns only when activation has finished, but the work itself runs as a transient
# systemd unit (tenuro-activate-<sha prefix>), so a dropped SSH session can't interrupt it.
# Its log is printed at the end and kept in /srv/tenuro/state/activate-<sha>.log.
#
# Order of work, under a lock on the root-only state folder:
#   0. bring nginx and the boot setup back in line with the recorded active slot if an
#      earlier run was killed (including mid-rollback)
#   1. freeze the upload into a root-owned release: move it into a root-only staging folder,
#      re-check it is a real folder, enforce the size cap, refuse hardlinks, chown -h, set
#      modes top-down without following links, then reject links, hardlinks, special files
#      and anything not root:tenuro; share the Node binary with an earlier frozen release
#      only if both match runtime/SHA256
#   2. point the idle slot at it, run migrations, start it
#   3. check it directly: health reports the sha, noindex and CSP present, journey checks
#   4. switch nginx with one reload after nginx -t
#   5. check again through nginx; any failure or signal from here to the commit restores the
#      snippet, reloads and stops the idle slot (rollback)
#   6. record the new active slot, enable it for boot, retire the old one after a delay,
#      keep 3 releases
set -euo pipefail
umask 022

# Test mode exists only for deploy/test/run.sh. It needs an explicit flag AND a non-root
# caller, so it can never apply under sudo (EUID 0, and sudo's env_reset drops the flag).
if [[ ${TENURO_ACTIVATE_TEST:-} == 1 && $EUID -ne 0 ]]; then
  BASE=${TENURO_TEST_BASE:?}
  SNIPPET=${TENURO_TEST_SNIPPET:?}
  OWNER_USER=${TENURO_TEST_OWNER_USER:-$(id -un)}
  OWNER_GROUP=${TENURO_TEST_OWNER_GROUP:-$(id -gn)}
  SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
  DETACH=${TENURO_TEST_DETACH:-0}
  MAX_UPLOAD_MB=${TENURO_TEST_MAX_UPLOAD_MB:-400}
  TRIES_IDLE=2 TRIES_NGINX=2 PAUSE=0
else
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin
  if [[ $EUID -ne 0 ]]; then echo "tenuro-activate must run as root" >&2; exit 1; fi
  BASE=/srv/tenuro
  SNIPPET=/etc/nginx/tenuro/active-slot.conf
  OWNER_USER=root OWNER_GROUP=tenuro
  SELF=/usr/local/sbin/tenuro-activate
  DETACH=1
  MAX_UPLOAD_MB=400
  TRIES_IDLE=30 TRIES_NGINX=10 PAUSE=1
fi
readonly BASE SNIPPET OWNER_USER OWNER_GROUP SELF DETACH MAX_UPLOAD_MB TRIES_IDLE TRIES_NGINX PAUSE
readonly HOST=tenuro.jeffgicharu.com KEEP=3 RETIRE_AFTER=120
readonly STATE=$BASE/state STAGE=$BASE/staging

log() {
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2 || true
  logger -t tenuro-activate -- "$*" 2>/dev/null || true
}
die() { log "FAIL: $*"; exit 1; }

RUN=0
if [[ ${1:-} == --run ]]; then RUN=1; shift; fi
[[ $# -eq 1 ]] || die "usage: tenuro-activate <40-character commit sha>"
SHA=$1
[[ $SHA =~ ^[0-9a-f]{40}$ ]] || die "not a 40-character lowercase sha"
readonly SHA RUN
if ((RUN)) && [[ -z ${INVOCATION_ID:-} ]]; then
  die "--run is only used inside the transient activation unit"
fi

# ---------------------------------------------------------------- detach from the caller
if ((DETACH && !RUN)); then
  trap '' HUP PIPE   # a dropped SSH session must not stop us waiting or printing
  logf=$STATE/activate-$SHA.log
  rc=0
  systemd-run --quiet --wait --collect --unit="tenuro-activate-${SHA:0:12}" \
    --property=StandardOutput="truncate:$logf" --property=StandardError=inherit \
    --property=RuntimeMaxSec=900 -- "$SELF" --run "$SHA" || rc=$?
  cat -- "$logf" 2>/dev/null || true
  find "$STATE" -maxdepth 1 -name 'activate-*.log' -mtime +14 -delete 2>/dev/null || true
  exit "$rc"
fi

# ---------------------------------------------------------------- lock
# The state folder is root-only (0700), so no other user can pre-create or hold this lock.
exec 9<"$STATE"
flock -n 9 || die "another activation is running"

slot_port() { case $1 in blue) echo 9000 ;; green) echo 9001 ;; esac; }
write_snippet() { # $1 slot
  local tmp
  tmp=$(mktemp "$SNIPPET.XXXXXX")
  # shellcheck disable=SC2016  # nginx variables are literal text
  printf 'set $tenuro_slot %s;\nset $tenuro_port %s;\n' "$1" "$(slot_port "$1")" >"$tmp"
  chmod 644 -- "$tmp"
  mv -f -- "$tmp" "$SNIPPET"
}
snippet_slot() { grep -Eo 'tenuro_slot (blue|green)' "$SNIPPET" 2>/dev/null | cut -d' ' -f2; }

ACTIVE=$(cat "$STATE/active" 2>/dev/null || echo none)
case $ACTIVE in
  blue) IDLE=green ;;
  green | none) IDLE=blue ;;
  *) die "unrecognised state file" ;;
esac
IDLE_PORT=$(slot_port "$IDLE")
readonly ACTIVE IDLE IDLE_PORT

# ---------------------------------------------------------------- 0. reconcile
# A run killed outright (SIGKILL, power loss) can leave things out of line with the last
# verified slot: nginx pointing elsewhere, an interrupted rollback (its snippet backup still
# present), or the boot setup not handed over. The state file is written only after every
# check passed, so trust it and repair all three before doing anything else.
if [[ $ACTIVE != none ]]; then
  systemctl enable --quiet --now "tenuro@$ACTIVE.service" || log "warning: could not enable and start tenuro@$ACTIVE"
  systemctl disable --quiet "tenuro@$IDLE.service" || true
  if [[ -e $SNIPPET.prev || $(snippet_slot) != "$ACTIVE" ]]; then
    log "restoring nginx to the active slot $ACTIVE (it named '$(snippet_slot)'$([[ -e $SNIPPET.prev ]] && echo ', and an earlier switch or rollback was interrupted'))"
    write_snippet "$ACTIVE"
    nginx -t -q || die "nginx -t failed with the snippet for the active slot $ACTIVE; fix nginx, then run again"
    systemctl reload nginx || die "nginx reload failed while restoring the active slot $ACTIVE"
    rm -f -- "$SNIPPET.prev"
  fi
elif [[ -e $SNIPPET.prev ]]; then
  # The very first activation was interrupted mid-switch; nothing is live yet.
  log "restoring the snippet left by an interrupted first activation"
  mv -f -- "$SNIPPET.prev" "$SNIPPET"
  if nginx -t -q; then systemctl reload nginx || true; fi
fi
log "activating $SHA on $IDLE (active: $ACTIVE)"

# ---------------------------------------------------------------- rollback on exit
PHASE=prepare # prepare -> switched -> committed (rolling-back while a rollback runs)
# Puts the previous snippet back and reloads. The backup stays until the reload has
# succeeded, so an interrupted rollback is caught by step 0 of the next run. The idle slot is
# stopped only once nginx no longer points at it; if nginx -t or the reload fails, both slots
# keep running and this returns 1.
rollback_switch() {
  [[ $PHASE == switched ]] || return 0
  PHASE=rolling-back
  if [[ -e $SNIPPET.prev ]]; then
    if cp -p -- "$SNIPPET.prev" "$SNIPPET.restore"; then mv -f -- "$SNIPPET.restore" "$SNIPPET" || true; fi
  fi
  if nginx -t -q && systemctl reload nginx; then
    rm -f -- "$SNIPPET.prev"
    systemctl stop "tenuro@$IDLE.service" || true
    PHASE=prepare
    return 0
  fi
  log "ROLLBACK INCOMPLETE: nginx -t or the reload failed with the previous snippet restored," \
      "so both slots are left running. Fix nginx, then run tenuro-activate again: it restores" \
      "nginx to $ACTIVE before anything else."
  PHASE=prepare
  return 1
}
on_exit() {
  local rc=$?
  if [[ $PHASE == switched ]]; then
    if [[ $(cat "$STATE/active" 2>/dev/null) == "$IDLE" ]]; then
      PHASE=committed # the commit landed just before the interruption
      rm -f -- "$SNIPPET.prev"
    else
      log "interrupted after the switch; restoring nginx to $ACTIVE"
      rollback_switch || true
    fi
  fi
  exit "$rc"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail_idle() { systemctl stop "tenuro@$IDLE.service" || true; die "$*"; }
sha256_of() { sha256sum -- "$1" | cut -d' ' -f1; }

# ---------------------------------------------------------------- 1. freeze
REL=$BASE/releases/$SHA
if [[ ! -d $REL ]]; then
  INC=$BASE/incoming/$SHA
  [[ -d $INC && ! -L $INC ]] || die "no upload found for $SHA"
  TMP=$STAGE/$SHA
  rm -rf --one-file-system -- "$TMP"

  # Move the tree into the root-only staging folder, out of the upload user's reach.
  mv -T -- "$INC" "$TMP"
  # The upload user could have swapped the folder for a symlink after the check above;
  # nothing below may ever be handed a link.
  if [[ -L $TMP || ! -d $TMP ]]; then
    rm -f -- "$TMP"
    die "upload rejected: incoming/$SHA was not a real folder"
  fi
  reject() { rm -rf --one-file-system -- "$TMP"; die "upload rejected: $*"; }

  # A size cap protects the shared disk. du never follows links (-P is its default).
  size_mb=$(du -sxm -- "$TMP" | cut -f1)
  ((size_mb <= MAX_UPLOAD_MB)) || reject "${size_mb} MB is larger than the ${MAX_UPLOAD_MB} MB cap"
  # A hardlink could point at a file outside the upload; refuse before chown could touch it.
  bad=$(find "$TMP" -xdev -type f -links +1 -print -quit)
  [[ -z $bad ]] || reject "hardlinked file at ${bad#"$TMP"/}"

  # Ownership first, without following links. Then modes, top-down and one entry at a time
  # (-exec ... \;): each folder is locked before find reads its contents, so no entry can be
  # swapped for a link between find's check and chmod. find never follows links itself, and
  # -links 1 keeps chmod off any file that gained a second link in the meantime.
  chown -hR "$OWNER_USER:$OWNER_GROUP" -- "$TMP"
  find "$TMP" -xdev \( -type d -exec chmod 0750 -- {} \; \) -o \( -type f -links 1 -exec chmod 0640 -- {} \; \)
  bad=$(find "$TMP" -xdev \( -type l -o \( ! -type f ! -type d \) -o \( -type f -links +1 \) \
          -o ! -user "$OWNER_USER" -o ! -group "$OWNER_GROUP" \) -print -quit)
  [[ -z $bad ]] || reject "symlink, hardlink, special file or wrong owner at ${bad#"$TMP"/}"

  for f in REVISION runtime/bin/node runtime/SHA256 server/index.mjs server/migrate.mjs \
           server/smoke.mjs server/rebuild.mjs ops/smoke-query.json; do
    [[ -f $TMP/$f ]] || reject "missing $f"
  done
  [[ -d $TMP/public ]] || reject "missing public/"
  [[ $(tr -d '[:space:]' <"$TMP/REVISION") == "$SHA" ]] || reject "REVISION does not match $SHA"

  want=$(tr -d '[:space:]' <"$TMP/runtime/SHA256")
  [[ $want =~ ^[0-9a-f]{64}$ ]] || reject "runtime/SHA256 is not a sha256"
  [[ $(sha256_of "$TMP/runtime/bin/node") == "$want" ]] || reject "runtime/bin/node does not match runtime/SHA256"

  # Share the Node binary with an earlier frozen release when it is byte-identical.
  # Both sides are root-owned and verified; incoming/ is never involved.
  for prev in "$BASE"/releases/*/; do
    prev=${prev%/}
    [[ -d $prev && ! -L $prev ]] || continue
    pn=$prev/runtime/bin/node
    [[ -f $pn && ! -L $pn ]] || continue
    [[ $(stat -c %U -- "$pn") == "$OWNER_USER" ]] || continue
    [[ $(tr -d '[:space:]' <"$prev/runtime/SHA256" 2>/dev/null) == "$want" ]] || continue
    [[ $(sha256_of "$pn") == "$want" ]] || continue
    ln -f -- "$pn" "$TMP/runtime/bin/node.link"
    mv -f -- "$TMP/runtime/bin/node.link" "$TMP/runtime/bin/node"
    log "runtime/bin/node shared with $(basename "$prev")"
    break
  done

  chmod 0750 -- "$TMP/runtime/bin/node"
  # nginx (www-data) serves public/ directly; everything else stays tenuro-only.
  chmod o+x -- "$TMP"
  find "$TMP/public" -xdev -type d -exec chmod o+rx -- {} +
  find "$TMP/public" -xdev -type f -exec chmod o+r -- {} +
  mv -T -- "$TMP" "$REL"
  log "froze release $SHA"
else
  log "reusing kept release $SHA"
  [[ $(tr -d '[:space:]' <"$REL/REVISION") == "$SHA" ]] || die "kept release REVISION does not match $SHA"
fi
touch -- "$REL"

# ---------------------------------------------------------------- 2. start the idle slot
if [[ -d $REL/public/assets ]]; then
  # Hashed assets from recent releases stay reachable, so open tabs survive a deploy.
  rsync -r --ignore-existing --chmod=D755,F644 -- "$REL/public/assets/" "$BASE/assets/"
fi
ln -sfn -- "$REL" "$BASE/slots/.$IDLE.new"
mv -Tf -- "$BASE/slots/.$IDLE.new" "$BASE/slots/$IDLE"
systemctl start "tenuro-migrate@$IDLE.service" || fail_idle "migrations failed"
systemctl restart "tenuro@$IDLE.service" || fail_idle "tenuro@$IDLE failed to start"

# ---------------------------------------------------------------- 3. check it directly
health_ok() { # $1 base url, then extra curl args
  local body
  body=$(curl -fsS --max-time 3 "${@:2}" "$1/api/health") || return 1
  grep -Eq "\"sha\" *: *\"$SHA\"" <<<"$body" && grep -Eq '"db" *: *"ok"' <<<"$body"
}
page_ok() { # $1 base url, then extra curl args: noindex (header and meta) and a CSP header
  local hdrs page
  hdrs=$(curl -fsS -D - -o /dev/null --max-time 5 "${@:2}" "$1/") || return 1
  grep -qi '^x-robots-tag: *noindex' <<<"$hdrs" || return 1
  grep -qi '^content-security-policy:' <<<"$hdrs" || return 1
  page=$(curl -fsS --max-time 5 "${@:2}" "$1/") || return 1
  grep -Eqi '<meta[^>]+name="robots"[^>]+noindex' <<<"$page"
}
retry() { # $1 tries, then command
  local n=$1 i
  shift
  for ((i = 0; i < n; i++)); do
    "$@" && return 0
    sleep "$PAUSE"
  done
  return 1
}

IDLE_URL=http://127.0.0.1:$IDLE_PORT
retry "$TRIES_IDLE" health_ok "$IDLE_URL" || fail_idle "idle slot $IDLE never reported $SHA as healthy"
page_ok "$IDLE_URL" || fail_idle "idle slot $IDLE is missing noindex or CSP"
systemctl start "tenuro-smoke@$IDLE.service" || fail_idle "journey checks failed on $IDLE"

# ---------------------------------------------------------------- 4. switch
cp -p -- "$SNIPPET" "$SNIPPET.prev"
PHASE=switched
write_snippet "$IDLE"
if ! nginx -t -q; then
  # nginx was never reloaded, so it still serves the old slot: put the file back, no reload.
  mv -f -- "$SNIPPET.prev" "$SNIPPET"
  PHASE=prepare
  fail_idle "nginx -t failed; nothing was switched"
fi
systemctl reload nginx

# ---------------------------------------------------------------- 5. check through nginx
VIA=(--resolve "$HOST:443:127.0.0.1" -k) # origin certificate; the name is pinned to loopback
nginx_ok() {
  health_ok "https://$HOST" "${VIA[@]}" || return 1
  page_ok "https://$HOST" "${VIA[@]}" || return 1
  local page asset
  page=$(curl -fsS --max-time 5 "${VIA[@]}" "https://$HOST/") || return 1
  asset=$(grep -Eo '/assets/[A-Za-z0-9._-]+\.js' <<<"$page" | head -n1) || true
  [[ -n $asset ]] || return 1
  curl -fsS -o /dev/null --max-time 5 "${VIA[@]}" "https://$HOST$asset" || return 1
  curl -fsS --max-time 5 "${VIA[@]}" -H 'content-type: application/json' -H 'x-tenuro-client: smoke' \
    --data-binary @"$REL/ops/smoke-query.json" "https://$HOST/graphql" | grep -q '"data"'
}
if ! retry "$TRIES_NGINX" nginx_ok; then
  rollback_switch || die "checks through nginx failed and the rollback could not reload nginx; both slots are running"
  die "checks through nginx failed; rolled back to $ACTIVE"
fi

# ---------------------------------------------------------------- 6. commit
printf '%s\n' "$IDLE" >"$STATE/active.tmp"
mv -f -- "$STATE/active.tmp" "$STATE/active"
PHASE=committed
rm -f -- "$SNIPPET.prev"
ln -sfn -- "$REL" "$BASE/.current.new"
mv -Tf -- "$BASE/.current.new" "$BASE/current"

# Only the active slot starts at boot. The old slot keeps serving in-flight requests until
# tenuro-retire stops it.
systemctl enable --quiet "tenuro@$IDLE.service" || log "warning: could not enable tenuro@$IDLE for boot"
if [[ $ACTIVE != none ]]; then
  systemctl disable --quiet "tenuro@$ACTIVE.service" || log "warning: could not disable tenuro@$ACTIVE"
  systemd-run --quiet --collect --on-active="$RETIRE_AFTER" \
    --unit="tenuro-retire-$(date +%s)" /usr/local/sbin/tenuro-retire ||
    log "warning: could not schedule tenuro-retire; stop tenuro@$ACTIVE by hand"
fi

# Keep the newest $KEEP releases, never one a slot points at; prune assets to match.
declare -A pinned=()
for s in blue green; do
  t=$(readlink -f -- "$BASE/slots/$s" 2>/dev/null || true)
  [[ -n $t ]] && pinned[$(basename "$t")]=1
done
n=0
while IFS= read -r r; do
  [[ $r =~ ^[0-9a-f]{40}$ ]] || continue
  if [[ -n ${pinned[$r]:-} ]] || ((n < KEEP)); then
    n=$((n + 1))
    continue
  fi
  rm -rf --one-file-system -- "${BASE:?}/releases/$r"
  log "pruned release $r"
done < <(ls -1t -- "$BASE/releases")

declare -A live=()
for f in "$BASE"/releases/*/public/assets/*; do
  [[ -e $f ]] && live[$(basename "$f")]=1
done
for f in "$BASE"/assets/*; do
  [[ -e $f ]] || continue
  [[ -n ${live[$(basename "$f")]:-} ]] || rm -rf --one-file-system -- "$f"
done
find "$BASE/incoming" "$STAGE" -mindepth 1 -maxdepth 1 -mtime +2 -exec rm -rf --one-file-system -- {} +

log "OK: $SHA is live on $IDLE (port $IDLE_PORT)"
echo "OK $SHA $IDLE" || true
