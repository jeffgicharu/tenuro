[Unit]
Description=Tenuro app (%i slot)
Documentation=https://github.com/jeffgicharu/tenuro/blob/main/deploy/README.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=tenuro-%i
Group=tenuro-%i
EnvironmentFile=/srv/tenuro/shared/app.env
EnvironmentFile=/srv/tenuro/shared/slot-%i.env
Environment=NODE_ENV=production
WorkingDirectory=/srv/tenuro/slots/%i
ExecStart=/srv/tenuro/slots/%i/runtime/bin/node --max-old-space-size=144 --enable-source-maps server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
StateDirectory=tenuro-%i
StateDirectoryMode=0700
UMask=0077

# Filesystem view: /var, /srv, /opt, /mnt and /media are empty except for Tenuro's own
# folders, and other services' config is hidden, so other sites' files on this shared host
# are out of reach even when they are world-readable.
TemporaryFileSystem=/var:ro /srv:ro /opt:ro /mnt:ro /media:ro
BindReadOnlyPaths=/srv/tenuro
BindPaths=/var/lib/tenuro-%i
InaccessiblePaths=-/etc/nginx -/etc/letsencrypt -/etc/ssl/private -/etc/ssl/cloudflare

MemoryMax=224M
MemorySwapMax=0
TasksMax=64

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# AF_NETLINK lets os.networkInterfaces() work; IPAddressDeny still blocks all non-local traffic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
# V8's JIT needs writable and executable memory; every other protection stays on.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
