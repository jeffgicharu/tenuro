[Unit]
Description=Tenuro nightly reset of the shared data and private sessions
Documentation=https://github.com/jeffgicharu/tenuro/blob/main/deploy/README.md
After=postgresql.service
Wants=postgresql.service
ConditionPathExists=/srv/tenuro/current/server/rebuild.mjs

[Service]
Type=oneshot
User=tenuro-jobs
Group=tenuro-jobs
EnvironmentFile=/srv/tenuro/shared/ops.env
Environment=NODE_ENV=production
# Caps glibc malloc arenas: the seed's native memory otherwise fragments and RSS creeps toward the cap.
Environment=MALLOC_ARENA_MAX=2
WorkingDirectory=/srv/tenuro/current
ExecStart=/srv/tenuro/current/runtime/bin/node --max-old-space-size=144 server/rebuild.mjs
TimeoutStartSec=1800
StateDirectory=tenuro-jobs
StateDirectoryMode=0700
UMask=0077

# Filesystem view: /var, /srv, /opt, /mnt and /media are empty except for Tenuro's own
# folders, and other services' config is hidden, so other sites' files on this shared host
# are out of reach even when they are world-readable.
TemporaryFileSystem=/var:ro /srv:ro /opt:ro /mnt:ro /media:ro
BindReadOnlyPaths=/srv/tenuro
BindPaths=/var/lib/tenuro-jobs
InaccessiblePaths=-/etc/nginx -/etc/letsencrypt -/etc/ssl/private -/etc/ssl/cloudflare

# The box is shared: run behind everyone else.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=192M
MemorySwapMax=0
TasksMax=32

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# AF_NETLINK lets os.networkInterfaces() work; IPAddressDeny still blocks all non-local traffic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
# V8's JIT needs writable and executable memory; every other protection stays on.
MemoryDenyWriteExecute=no
