[Unit]
Description=Tenuro nightly database backup
Documentation=https://github.com/jeffgicharu/tenuro/blob/main/deploy/README.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=tenuro-backup
Group=tenuro-backup
EnvironmentFile=/srv/tenuro/shared/ops.env
ExecStart=/usr/local/lib/tenuro/backup.sh
TimeoutStartSec=900
StateDirectory=tenuro-backup
StateDirectoryMode=0700
UMask=0077

# Filesystem view: /var, /srv, /opt, /mnt and /media are empty except for the backup folder,
# and other services' config is hidden.
TemporaryFileSystem=/var:ro /srv:ro /opt:ro /mnt:ro /media:ro
BindPaths=/var/lib/tenuro-backup
InaccessiblePaths=-/etc/nginx -/etc/letsencrypt -/etc/ssl/private -/etc/ssl/cloudflare

Nice=10
IOSchedulingClass=idle
MemoryMax=96M
MemorySwapMax=0
TasksMax=16

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryDenyWriteExecute=yes
