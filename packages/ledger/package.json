    "bench": "LEDGER_BENCH=1 vitest run",
    "fixtures": "python3 fixtures/generate.py"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "fast-check": "^4.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
