#!/bin/bash
# Creates /srv/tenuro/shared/app.env and ops.env with fresh database passwords and app secrets.
# Run once as root. Prints variable names only, never values. Refuses to overwrite.
set -euo pipefail
umask 077

# Test mode exists only for deploy/test/secrets.sh: explicit flag and a non-root caller.
if [[ ${TENURO_SECRETS_TEST:-} == 1 && $EUID -ne 0 ]]; then
  SHARED=${TENURO_TEST_SHARED:?}
else
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin
  if [[ $EUID -ne 0 ]]; then echo "run as root" >&2; exit 1; fi
  SHARED=/srv/tenuro/shared
fi
readonly APP=$SHARED/app.env OPS=$SHARED/ops.env
readonly PSQL=/usr/lib/postgresql/16/bin/psql

for f in "$APP" "$OPS"; do
  if [[ -e $f ]]; then echo "$f already exists; refusing to overwrite" >&2; exit 1; fi
done

gen() { openssl rand -hex 32; }
OWNER_PW=$(gen)
APP_PW=$(gen)

# Passwords reach psql on stdin, never on a command line. The two SETs keep them out of the
# server log, whether or not the statement succeeds. psql's own output is discarded because
# on an error it echoes the failing statement, password included.
if ! runuser -u postgres -- "$PSQL" -X -q -v ON_ERROR_STOP=1 -d postgres >/dev/null 2>&1 <<SQL
SET log_statement = 'none';
SET log_min_error_statement = panic;
ALTER ROLE tenuro     PASSWORD '${OWNER_PW}';
ALTER ROLE tenuro_app PASSWORD '${APP_PW}';
SQL
then
  unset OWNER_PW APP_PW
  echo "Setting the database passwords failed. psql's output is withheld because it would include them." >&2
  echo "Check that PostgreSQL 16 is running and that the roles tenuro and tenuro_app exist (install.sh creates them)." >&2
  exit 1
fi

write() { # $1 file, $2 group; contents on stdin
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  cat >"$tmp"
  chown "root:$2" "$tmp"
  chmod 640 "$tmp"
  mv -f -- "$tmp" "$1"
}

write "$APP" tenuro <<EOF
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tenuro
PGUSER=tenuro_app
PGPASSWORD=${APP_PW}
SESSION_SECRET=$(gen)
SANDBOX_SECRET=$(gen)
ICS_FEED_SECRET=$(gen)
EOF

write "$OPS" tenuro-ops <<EOF
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tenuro
PGUSER=tenuro
PGPASSWORD=${OWNER_PW}
EOF

unset OWNER_PW APP_PW
echo "wrote $APP (root:tenuro 0640): PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD SESSION_SECRET SANDBOX_SECRET ICS_FEED_SECRET"
echo "wrote $OPS (root:tenuro-ops 0640): PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD"
