#!/bin/sh
# Forced command for the CI activation key. Accepts exactly one 40-character lowercase sha
# and hands it to the root activation script, which validates it again.
set -eu
sha=${SSH_ORIGINAL_COMMAND:-}
case "$sha" in
  "" | *[!0-9a-f]*) echo "expected a 40-character sha" >&2; exit 2 ;;
esac
[ "${#sha}" -eq 40 ] || { echo "expected a 40-character sha" >&2; exit 2; }
exec /usr/bin/sudo -n /usr/local/sbin/tenuro-activate "$sha"
